    {
      "id": "tag-3",
      "form": "table",
      "source_id": "tep-reactor-cooling.tags-and-limits",
      "locator": "reactor-tag-and-limit-table/tags-and-constraints/table-1",
      "matches": {
        "Tag": "XMEAS\\(21\\)",
        "Description": "Reactor cooling-water outlet temperature"
      },
      "item": {
        "kind": "SIGNAL_MENTION",
        "scope": [
          {
            "kind": "ENTITY",
            "id": "reactor"
          }
        ],
        "target_kind": "SIGNAL",
        "targets": [
          "reactor_cooling.outlet_temperature"
        ],
        "mention_column": "Description"
      }
    },
    {
      "id": "tag-4",
      "form": "table",
      "source_id": "tep-reactor-cooling.tags-and-limits",
      "locator": "reactor-tag-and-limit-table/tags-and-constraints/table-1",
      "matches": {
        "Tag": "XMV\\(10\\)",
        "Description": "Reactor cooling-water flow manipulation"
      },
      "item": {
        "kind": "SIGNAL_MENTION",
        "scope": [
          {
            "kind": "ENTITY",
            "id": "reactor"
          }
        ],
        "target_kind": "SIGNAL",
        "targets": [
          "reactor_cooling.flow_actuator"
        ],
        "mention_column": "Description"
      }
    },
    {
      "id": "ambiguous-temperature",
      "form": "phrase",
      "source_id": "tep-reactor-cooling.operating-procedure",
      "locator": "reactor-cooling-review-procedure/review-steps/list-1/step-4",
      "phrase": "reactor-side temperature",
      "item": {
        "kind": "SIGNAL_MENTION",
        "scope": [
          {
            "kind": "ENTITY",
            "id": "reactor"
          }
        ],
        "target_kind": "SIGNAL",
        "targets": [
          "reactor.temperature_measurement",
          "reactor_cooling.outlet_temperature"
        ]
      }
    },
    {
      "id": "control-relation",
      "form": "phrase",
      "source_id": "tep-reactor-cooling.subsystem",
      "locator": "reactor-and-cooling-water-loop/control-relation/paragraph-1",
      "phrase": "XMV(10) manipulates reactor cooling-water flow. Increasing cooling flow is a\nmeans of increasing heat removal, subject to the thermal state and available\nutility conditions.",
      "item": {
        "kind": "CONTROL_RELATION",
        "scope": [
          {
            "kind": "ENTITY",
            "id": "reactor"
          }
        ],
        "variables": [
          "reactor_cooling.flow_actuator",
          "reactor"
        ],
        "conditions": "Subject to the thermal state and available utility conditions.",
        "uncertainties": "Qualitative relation only; no controller tuning specified.",
        "units": "qualitative"
      }
    },
    {
      "id": "competing-normal-limit",
      "form": "phrase",
      "source_id": "tep-reactor-cooling.troubleshooting",
      "locator": "reactor-cooling-troubleshooting-note/intentional-competing-limit/paragraph-1",
      "phrase": "The normal upper reactor process-temperature limit is 145 degC.",
      "item": {
        "kind": "OPERATING_LIMIT",
        "scope": [
          {
            "kind": "ENTITY",
            "id": "reactor"
          }
        ],
        "variable": "reactor.temperature_measurement",
        "constraint": "normal_upper",
        "conditions": "normal operation",
        "uncertainties": "Deliberate authored discrepancy; explicit review required.",
        "value_text": "145 degC"
      }
    },
    {
      "id": "unverified-inlet-tag",
      "form": "phrase",
      "source_id": "tep-reactor-cooling.troubleshooting",
      "locator": "reactor-cooling-troubleshooting-note/unverified-instrumentation-proposal/paragraph-1",
      "phrase": "RCW-IN-TT is a reactor cooling-water inlet temperature\ntransmitter.",
      "item": {
        "kind": "SIGNAL_MENTION",
        "scope": [
          {
            "kind": "ENTITY",
            "id": "reactor"
          }
        ],
        "target_kind": "SIGNAL",
        "targets": [
          "RCW-IN-TT"
        ]
      }
    }
  ]
