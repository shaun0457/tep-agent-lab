        "scope": [
          {
            "kind": "ENTITY",
            "id": "reactor"
          }
        ],
        "target_kind": "SIGNAL",
        "targets": [
          "reactor.temperature_measurement"
        ],
        "mention_column": "Description"
      }
    },
    {
      "id": "limit-2-normal-upper",
      "form": "table",
