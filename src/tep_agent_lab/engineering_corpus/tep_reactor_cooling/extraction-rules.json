{
  "schema_version": "deterministic-extraction-rules/v1",
  "rule_set_id": "tep-reactor-cooling.deterministic-extraction",
  "version": "1",
  "authored_at": "2026-10-11",
  "units": [
    "degC",
    "kPa gauge",
    "% command"
  ],
  "rules": [
    {
      "id": "tag-1",
      "form": "table",
      "source_id": "tep-reactor-cooling.tags-and-limits",
      "locator": "reactor-tag-and-limit-table/tags-and-constraints/table-1",
      "matches": {
        "Tag": "XMEAS\\(7\\)",
        "Description": "Reactor pressure"
      },
      "item": {
        "kind": "SIGNAL_MENTION",
        "scope": [
          {
            "kind": "ENTITY",
            "id": "reactor"
          }
        ],
        "target_kind": "SIGNAL",
        "targets": [
          "reactor.pressure_measurement"
        ],
        "mention_column": "Description"
      }
    },
    {
      "id": "limit-1-normal-upper",
      "form": "table",
      "source_id": "tep-reactor-cooling.tags-and-limits",
      "locator": "reactor-tag-and-limit-table/tags-and-constraints/table-1",
      "matches": {
        "Tag": "XMEAS\\(7\\)",
        "Unit": "kPa gauge",
        "Normal value/range": "Base [0-9]+(?:\\.[0-9]+)?; normal upper limit (?P<value>[0-9]+(?:\\.[0-9]+)?)"
      },
      "item": {
        "kind": "OPERATING_LIMIT",
        "scope": [
          {
            "kind": "ENTITY",
            "id": "reactor"
          }
        ],
        "variable": "reactor.pressure_measurement",
        "constraint": "normal_upper",
        "conditions": "normal operation",
        "uncertainties": "Source extraction only; not engineering verification.",
        "number_column": "Normal value/range",
        "unit_column": "Unit"
      }
    },
    {
      "id": "limit-1-shutdown-high",
      "form": "table",
      "source_id": "tep-reactor-cooling.tags-and-limits",
      "locator": "reactor-tag-and-limit-table/tags-and-constraints/table-1",
      "matches": {
        "Tag": "XMEAS\\(7\\)",
        "Unit": "kPa gauge",
        "Alarm/shutdown limits": "Alarm unspecified; shutdown high (?P<value>[0-9]+(?:\\.[0-9]+)?)"
      },
      "item": {
        "kind": "OPERATING_LIMIT",
        "scope": [
          {
            "kind": "ENTITY",
            "id": "reactor"
          }
        ],
        "variable": "reactor.pressure_measurement",
        "constraint": "shutdown_high",
        "conditions": "shutdown constraint",
        "uncertainties": "Source extraction only; not engineering verification.",
        "number_column": "Alarm/shutdown limits",
        "unit_column": "Unit"
      }
    },
    {
